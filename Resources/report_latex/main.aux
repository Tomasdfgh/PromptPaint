\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Directional prompt applied to ``interior home design,'' shifting from ``simple'' to ``complex'' at five evenly spaced weight values. The scene progressively gains architectural detail, layered furnishings, and visual density while the base prompt remains unchanged.}}{4}{figure.caption.9}\protected@file@percent }
\newlabel{fig:directional_interior}{{5}{4}{Directional prompt applied to ``interior home design,'' shifting from ``simple'' to ``complex'' at five evenly spaced weight values. The scene progressively gains architectural detail, layered furnishings, and visual density while the base prompt remains unchanged}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Prompt intervention during generation. Top: original paper's live dragging interaction, branching from ``action painting'' mid-generation. Bottom: our post-hoc scrubbing approach, where the user selects a branch point after viewing decoded step previews, then resumes with a new prompt (here, ``a dragon'') from the saved latent.}}{4}{figure.caption.10}\protected@file@percent }
\newlabel{fig:scrubbing_result}{{6}{4}{Prompt intervention during generation. Top: original paper's live dragging interaction, branching from ``action painting'' mid-generation. Bottom: our post-hoc scrubbing approach, where the user selects a branch point after viewing decoded step previews, then resumes with a new prompt (here, ``a dragon'') from the saved latent}{figure.caption.10}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.5}Post-hoc Generation Scrubbing}{4}{subsection.3.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Prompt intervention switching from ``a rabbit'' to ``a ceramic vase.'' Top: original paper's live dragging approach. Bottom: our post-hoc scrubbing, where the user branches from a saved intermediate latent. Earlier steps preserve the subject's form; later steps resolve the new material and shape.}}{4}{figure.caption.11}\protected@file@percent }
\newlabel{fig:intervention}{{7}{4}{Prompt intervention switching from ``a rabbit'' to ``a ceramic vase.'' Top: original paper's live dragging approach. Bottom: our post-hoc scrubbing, where the user branches from a saved intermediate latent. Earlier steps preserve the subject's form; later steps resolve the new material and shape}{figure.caption.11}{}}
