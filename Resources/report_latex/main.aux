\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Prompt mixing between ``a dog'' and ``a cat'' at five evenly spaced weights. Top: original paper using linear embedding interpolation on SD\,v1.5. Bottom: our Fréchet mean interpolation on SDXL, which keeps the mixed embedding on the CLIP hypersphere for more coherent blends.}}{3}{figure.caption.6}\protected@file@percent }
\newlabel{fig:prompt_mixing}{{2}{3}{Prompt mixing between ``a dog'' and ``a cat'' at five evenly spaced weights. Top: original paper using linear embedding interpolation on SD\,v1.5. Bottom: our Fréchet mean interpolation on SDXL, which keeps the mixed embedding on the CLIP hypersphere for more coherent blends}{figure.caption.6}{}}
